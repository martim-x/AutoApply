# ── auto-apply — copy to .env and edit ───────────────────────
# Secrets and overrides ONLY via environment / .env (never commit .env)

# App
APP_NAME=auto-apply
HOST=0.0.0.0
PORT=8080
DEBUG=false

# Database
# Default: local SQLite file (relative paths resolve from project root).
# On first start (missing file / empty Fly|Docker volume) the app creates
# DATA_DIR and a new empty SQLite DB with schema — no need to copy a local DB.
DATABASE_URL=sqlite:///./data/rabota_apply.sqlite
# Future external Postgres (adapter stub — same UnitOfWork ports):
# DATABASE_URL=postgresql+psycopg://rabota:CHANGE_ME@db:5432/rabota_apply
# DB_PASSWORD=CHANGE_ME
# Intentional wipe: set true once, restart, then set false (or delete the file /
# Docker volume ./data). While true, every restart destroys SQLite data.
# RESET_DB=false

DATA_DIR=./data
# SESSIONS_DIR=./data/sessions
LETTER_PATH=./letter_universal.txt

# Site / search defaults (overridden by config/launch.json)
BASE_URL=https://rabota.by
SEARCH_AREA=16
SEARCH_QUERIES=python-разработчик,python-developer,python разработчик,python developer
# Launch profile (strict text/JSON) — primary source for site/city/queries
LAUNCH_PATH=./config/launch.json
# Max vacancies to find/parse per search (overridden by launch.json vacancy_limit)
VACANCY_LIMIT=30
# Max queued vacancies to apply per run — all categories HIGH→MEDIUM→LOW
APPLY_LIMIT=30
DRY_RUN=false
# Visible browser by default (set true only in CI/headless hosts)
HEADLESS=false

# Remote interactive browser in Web UI (CDP screencast)
# Local: ENABLE_REMOTE_BROWSER=true — Login opens embedded viewer (works headless)
# Railway/Docker: ENABLE_REMOTE_BROWSER=true and HEADLESS=true
ENABLE_REMOTE_BROWSER=false
REMOTE_BROWSER_JPEG_QUALITY=55
REMOTE_BROWSER_EVERY_NTH_FRAME=1

# Filters
REQUIRE_REMOTE_OR_HYBRID=true
SKIP_GOV=true
REQUIRE_PYTHON_KEYWORDS=true

# Rate limits / retry (human-like)
MIN_ACTION_INTERVAL=2.0
AFTER_APPLY_DELAY=8.0
JITTER=0.35
MAX_PER_HOUR=40
MAX_PER_DAY=180
LOAD_RETRIES=3
LOAD_RETRY_DELAY=2.5
APPLY_RETRIES=2
NAVIGATION_TIMEOUT_MS=45000
CONTENT_TIMEOUT_MS=20000
SETTLE_MS=1200

# Owner gate (/login) + Admin UI (/admin)
# Gate protects / and /api/* when credentials are set.
# Prefer ADMIN_* (shared identity). Optional GATE_* overrides for the gate only.
ADMIN_USER=
ADMIN_PASSWORD=
# JWT signing secret for access (nexus_token) + refresh (refresh_token) cookies
# and aa_admin_session. Required in production.
ADMIN_SECRET=
# Optional dedicated gate credentials (fallback is ADMIN_USER / ADMIN_PASSWORD)
# GATE_USER=
# GATE_PASSWORD=
# Set true behind HTTPS so auth cookies get the Secure flag
AUTH_COOKIE_SECURE=false

# LinkedIn launch config (browser automation; separate from HH launch.json)
# LINKEDIN_LAUNCH_PATH=./config/linkedin.launch.json

# Scheduled PDF reports (in-process asyncio; one Railway service)
REPORT_SCHEDULE_ENABLED=false
REPORT_SCHEDULE_TIMEZONE=Europe/Minsk
REPORT_SCHEDULE_HOUR=4
REPORT_SCHEDULE_MINUTE=0
# Optional: minute hour * * *  (overrides HOUR/MINUTE when parseable)
# REPORT_SCHEDULE_CRON=0 4 * * *
REPORT_SCHEDULE_KIND=work
REPORT_SCHEDULE_PROFILE=default

# Scheduled vacancy parsing (separate from PDF; noon + midnight)
# Off locally for safety; on Railway set PARSE_SCHEDULE_ENABLED=true
PARSE_SCHEDULE_ENABLED=false
PARSE_SCHEDULE_TIMEZONE=Europe/Minsk
PARSE_SCHEDULE_TIMES=12:00,00:00
PARSE_SCHEDULE_PROFILE=default
PARSE_EARLY_STOP_ENABLED=true
PARSE_OLD_STREAK_STOP=5

# SMTP alerts (parse/apply errors, captcha → pause + email)
# Off by default; enable when ALERT_SMTP_HOST + ALERT_SMTP_TO are set
# Yandex: HOST=smtp.yandex.ru, PORT=465 (SSL) or 587 (TLS), USER=your@example.com
ALERT_SMTP_ENABLED=false
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
ALERT_SMTP_FROM=
ALERT_SMTP_TO=
ALERT_SMTP_TLS=true
ALERT_ON_ERROR=true
ALERT_ON_CAPTCHA=true
ALERT_ON_PARSE_FAIL=true
ALERT_RATE_LIMIT_SECONDS=600

# Optional future secrets
# API_KEY=
